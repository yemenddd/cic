generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")

  // Migrations must not go through the pooler. DATABASE_URL points at Neon's
  // PgBouncer, which multiplexes many clients onto few server connections and
  // therefore cannot hold the session-level advisory lock Prisma Migrate takes
  // to stop two deploys migrating at once — `migrate deploy` against it times
  // out waiting for a lock it can never acquire.
  //
  // DATABASE_URL_UNPOOLED is the unpooled endpoint, and is the variable Neon's
  // Vercel integration actually populates — DIRECT_URL exists in this project
  // but is set to an empty string, which Prisma rejects outright. Used for
  // migrations only; every ordinary query still goes through the pooler.
  directUrl = env("DATABASE_URL_UNPOOLED")
}

enum UserRole {
  ADMIN
  ATTENDEE
}

/**
 * Whether an account may be signed in to.
 *
 * Registering and being admitted are two different things. Anybody may fill in
 * the form; presenting a project or joining the organizing team is something
 * the committee decides, and until it has decided the account exists but its
 * door is shut.
 *
 * REJECTED is kept distinct from PENDING so a refusal can be told to the
 * person as a decision rather than as a wait that never ends.
 */
enum AccountStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SubmissionStatus {
  DRAFT
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

// How an attendance row came to exist. Recorded rather than inferred because
// the two are not equally trustworthy: a QR scan proves the badge was present,
// while a manual entry is an organizer's word for it. When the attendance list
// is later used to decide who earns a certificate, that distinction is the
// only thing separating an audit from a guess.
enum AttendanceMethod {
  QR
  MANUAL
}

// A gate counts arrivals at the venue for one day; a session checkpoint counts
// the people in one room. They are the same act of scanning, so they are one
// model — but a day's headline attendance figure means the gates only, and
// summing both would double-count everyone who walked into a workshop.
enum CheckpointKind {
  GATE
  SESSION
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         UserRole @default(ATTENDEE)

  // Profile — mirrors what the public registration form collects.
  phone            String?
  country          String?
  organization     String?
  category         String? // visitor | participant | volunteer
  /** One of the two paths in lib/submissions.ts, for participants. */
  track            String?

  /**
   * Added at the door rather than through the registration form.
   *
   * Somebody who turned up without having registered — no account, no
   * password, and an address that cannot receive mail. They are a real
   * attendee and belong in the figures, but they are not a user: nothing
   * should try to email them, and an analysis of how the conference was
   * reached has to be able to tell them apart from people who signed up in
   * advance. That difference is the single most useful thing the door
   * learns, so it is a column rather than something inferred from the shape
   * of an address.
   */
  walkIn           Boolean @default(false)
  /**
   * Which organizing committee a volunteer works with — one of the six in
   * lib/committees.ts. Chosen by the volunteer themselves, on their rota page,
   * and it decides which shifts they may claim.
   */
  committee        String?

  /**
   * Whether this account may be signed in to at all — see AccountStatus.
   *
   * Defaults to PENDING because the safe answer for a row created by a path
   * nobody has thought about yet is "not yet admitted". The registration route
   * and the organizer's own create-user form both set it deliberately.
   */
  status          AccountStatus @default(PENDING)
  /** The committee's reason, shown to the applicant on the sign-in screen. */
  statusNote      String?
  statusChangedAt DateTime?
  // The code printed on their badge and certificate. Unique because two
  // attendees holding the same one makes both documents ambiguous at the
  // door; the registration route retries on the (very rare) collision.
  confirmationCode String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /**
   * When the password last changed. Sessions are JWTs with no server-side
   * store, so this is what lets a reset end the ones already issued: a token
   * minted before this moment is refused by lib/auth-guards.ts.
   */
  passwordChangedAt DateTime?

  registrations       Registration[]
  savedSessions       SavedSession[]
  submissions         ProjectSubmission[]
  notifications       Notification[]
  announcements       Announcement[]
  attendance          Attendance[]
  // Scans this account performed on behalf of others — the organizer side of
  // the desk, kept apart from their own attendance.
  scansRecorded       Attendance[]         @relation("AttendanceRecorder")
  passwordResetTokens PasswordResetToken[]
  volunteerShifts     VolunteerAssignment[]

  /**
   * The admin directory's default order — admins first, then newest signups.
   * A plain index on `role` could not serve the `createdAt` half, so every
   * page load sorted the whole table to show twenty-five rows.
   *
   * This replaces that index rather than joining it: `role` is the leading
   * column, so a lookup by role alone still uses this one.
   */
  @@index([role, createdAt])
}

// Counts failed sign-ins and registration attempts so they can be slowed down.
//
// This has to live in the database rather than in memory: every request runs
// in its own short-lived serverless instance, so an in-process counter would
// be reset by the next cold start and shared by nobody.
model AuthThrottle {
  id          String    @id @default(cuid())
  scope       String // which limit this row belongs to
  key         String // the email or IP being counted
  failures    Int       @default(0)
  windowStart DateTime  @default(now())
  lockedUntil DateTime?
  updatedAt   DateTime  @updatedAt

  @@unique([scope, key])
  @@index([updatedAt])
}

// A message the organizers push to attendees' notification feeds.
//
// The Notification rows are what attendees actually read; this is the record
// of what was sent, to whom and by whom — without it an announcement would be
// unauditable and impossible to review after the fact.
model Announcement {
  id         String  @id @default(cuid())
  title      String
  body       String
  link       String?
  audience   String // 'all' | a category id from lib/categories.ts
  recipients Int // how many feeds it actually landed in

  sentById String?
  sentBy   User?   @relation(fields: [sentById], references: [id], onDelete: SetNull)

  /**
   * The feed entries this announcement produced.
   *
   * Without this link an announcement could be recalled from the panel and go
   * on sitting in every recipient's notifications, because nothing connected
   * the two but identical text. Cascading means withdrawing one actually
   * withdraws it.
   */
  notifications Notification[]

  createdAt DateTime @default(now())

  @@index([createdAt])
}

// What produced a notification. Stored rather than inferred from the `link`,
// which was the alternative — a committee decision and a venue announcement
// are different things to the person reading them, and guessing that from a
// URL breaks the moment a link changes or is absent.
enum NotificationKind {
  GENERAL
  ANNOUNCEMENT
  SUBMISSION
}

// In-platform notification. The committee's decision on a submission would
// otherwise only reach the attendee if they happened to log in and check.
model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  title String
  body  String?
  link  String? // where clicking it should take them
  read  Boolean          @default(false)
  // Defaults to GENERAL so rows written before this column keep working.
  kind  NotificationKind @default(GENERAL)

  /**
   * The announcement this came from, when it came from one.
   *
   * Null for anything raised by the platform itself — a committee decision on
   * a submission, say. Cascades, so deleting an announcement takes the copies
   * it put in people's feeds with it, and editing one can find them.
   */
  announcementId String?
  announcement   Announcement? @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
  @@index([announcementId])
}

// A session an attendee bookmarked into their personal agenda.
model SavedSession {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String
  session   ProgramSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([userId, sessionId])
  @@index([userId])
}

// An innovation project an attendee submits for the review committee.
// Deliberately separate from AchievementStudent: that model is a curated
// public showcase with no owner and no status, so mixing unreviewed
// submissions into it would put user content one missed filter away from
// the public site.
model ProjectSubmission {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  titleAr       String
  titleEn       String?
  summaryAr     String // one-line pitch
  descriptionAr String?
  track         String?
  teamMembers   String[]
  coverImageUrl String?
  videoId       String? // YouTube id

  status      SubmissionStatus @default(DRAFT)
  reviewNote  String? // committee feedback, shown to the owner
  reviewedAt  DateTime?
  submittedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  files SubmissionFile[]

  @@index([userId])
  @@index([status])
}

/**
 * A document attached to a submission.
 *
 * The section was built for innovations, which are shown off with a picture,
 * so a cover image was all it took. A research paper is not shown off with a
 * picture — it is the paper — and both paths now need somewhere to put the
 * work itself: a PDF, a presentation, a manuscript.
 *
 * The uploader's own filename is kept for display only. What is stored in blob
 * storage is a generated name (see lib/blob.ts), because the uploaded one is
 * attacker-controlled text that would otherwise decide a public URL and how
 * the file is served back.
 */
model SubmissionFile {
  id           String            @id @default(cuid())
  submissionId String
  submission   ProjectSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  url         String
  /** As the person named it on their own machine. Display only. */
  name        String
  contentType String
  sizeBytes   Int

  createdAt DateTime @default(now())

  @@index([submissionId])
}

// Every localized text field is stored as 3 columns (Ar/En/Tr) rather than
// JSON — Postgres is relational, and this keeps queries/forms straightforward.
model Speaker {
  id             String   @id @default(cuid())
  nameAr         String
  nameEn         String?
  nameTr         String?
  roleAr         String
  roleEn         String?
  roleTr         String?
  organizationAr String?
  organizationEn String?
  organizationTr String?
  topicAr        String?
  topicEn        String?
  topicTr        String?
  bioAr          String?
  bioEn          String?
  bioTr          String?
  photoUrl       String?
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([order])
}

model ProgramSession {
  id              String   @id @default(cuid())
  day             String // 'dayOne' | 'dayTwo'
  time            String
  titleAr         String
  titleEn         String?
  titleTr         String?

  /**
   * A sentence saying what happens in the session.
   *
   * Added when the programme stopped being a list of talks by named people:
   * with the speaker and the photograph gone, a card was a time and a title
   * and a lot of empty space. Deliberately its own column rather than reusing
   * `track` — a description is not a track, and a field that quietly means
   * something else is a thing the next person has to decode.
   */
  descriptionAr   String?
  descriptionEn   String?
  descriptionTr   String?
  speakerNameAr   String?
  speakerNameEn   String?
  speakerNameTr   String?
  speakerRoleAr   String?
  speakerRoleEn   String?
  speakerRoleTr   String?
  speakerPhotoUrl String?
  trackAr         String?
  trackEn         String?
  trackTr         String?
  color           String?
  order           Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  savedBy     SavedSession[]
  checkpoints Checkpoint[]

  @@index([day, order])
}

model GalleryImage {
  id        String   @id @default(cuid())
  imageUrl  String
  captionAr String?
  captionEn String?
  captionTr String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([order])
}

model Partner {
  id        String   @id @default(cuid())
  name      String
  logoUrl   String
  url       String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([order])
}

model HistoryEdition {
  id            String   @id @default(cuid())
  year          String
  titleAr       String
  titleEn       String?
  titleTr       String?
  descriptionAr String?
  descriptionEn String?
  descriptionTr String?
  attendees     String? // display text, e.g. "+5,000"
  speakersCount String?
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([order])
}

model AchievementEdition {
  id       String               @id @default(cuid())
  slug     String               @unique
  number   Int
  year     String
  titleAr  String?
  titleEn  String?
  titleTr  String?
  order    Int                  @default(0)
  students AchievementStudent[]

  @@index([order])
}

model AchievementStudent {
  id             String             @id @default(cuid())
  editionId      String
  edition        AchievementEdition @relation(fields: [editionId], references: [id], onDelete: Cascade)
  studentId      String
  name           String
  members        String[] // team members, empty for solo entries
  projectTitleAr String?
  projectTitleEn String?
  projectTitleTr String?
  role           String // 'innovator' | 'participant'
  photoUrls      String[]
  videoId        String?
  color          String?
  order          Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([editionId, order])
}

model Video {
  id             String   @id @default(cuid())
  section        String // 'film' | 'tv'
  editionLabelAr String?
  editionLabelEn String?
  editionLabelTr String?
  titleAr        String
  titleEn        String?
  titleTr        String?
  videoId        String
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([section, order])
}

model Registration {
  id               String   @id @default(cuid())
  fullName         String
  email            String
  phone            String?
  country          String?
  organization     String?
  category         String
  track            String?
  confirmationCode String?
  submittedAt      DateTime @default(now())

  // Optional: registrations made before accounts existed have no owner.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([submittedAt])
  @@index([userId])
}

// A place and moment at which badges are scanned — the venue door on day one,
// the door on day two, a workshop room.
//
// Attendance is deliberately not a boolean on User. "Did they attend?" is not
// one question: the organizers need day-one arrivals separately from day-two,
// and a room's count separately from the building's. A checkpoint is the thing
// a scan is *against*, which makes every one of those a count rather than a
// schema change.
model Checkpoint {
  id     String         @id @default(cuid())
  nameAr String
  day    String // 'dayOne' | 'dayTwo'
  kind   CheckpointKind @default(GATE)

  // Set only for SESSION checkpoints. SetNull rather than Cascade: deleting a
  // session from the program must not erase the record that fifty people were
  // counted into the room.
  sessionId String?
  session   ProgramSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  // Closed checkpoints refuse new scans. The desk is staffed for an hour, and
  // a scanner left open on a phone afterwards would keep admitting people to a
  // room that is empty.
  isOpen Boolean @default(true)

  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attendance Attendance[]

  @@index([day, order])
}

// One person, counted once at one checkpoint.
//
// The unique pair is what makes the scanner safe to point at a queue: a badge
// scanned twice — because the reader beeped and the holder did not hear it —
// is recognised as already counted rather than inflating the figure.
model Attendance {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  checkpointId String
  checkpoint   Checkpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)

  method AttendanceMethod @default(QR)

  // Who was holding the scanner. SetNull so removing a volunteer's account
  // leaves the attendance figures intact.
  recordedById String?
  recordedBy   User?   @relation("AttendanceRecorder", fields: [recordedById], references: [id], onDelete: SetNull)

  checkedInAt DateTime @default(now())

  @@unique([userId, checkpointId])
  @@index([checkpointId, checkedInAt])
  @@index([checkedInAt])
}

// A single-use link that lets somebody who has lost their password prove they
// still control their inbox.
//
// Without this, the only way back into an account was to ask an organizer to
// reset it and read the generated password out — which does not scale past a
// handful of people, and puts the organizers in the business of handling
// plaintext passwords on the busiest day of the conference.
//
// The token itself is never stored, only its SHA-256 hash: a read of this
// table must not hand the reader a working reset link for every account that
// has an outstanding one. SHA-256 rather than bcrypt is deliberate — bcrypt's
// slowness exists to protect low-entropy human passwords, and this is 256 bits
// of randomness, which is not guessable at any speed.
model PasswordResetToken {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  /**
   * SHA-256 of the token in the link. Unique so a lookup is an index hit.
   */
  tokenHash String @unique

  expiresAt DateTime
  /**
   * Set the moment it is spent, so a link in a mailbox works exactly once.
   */
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

/**
 * The handful of site-wide values an organizer needs to change without a
 * deployment.
 *
 * A single row, addressed by a fixed id. A key/value table was the other
 * option and is worse here: every read would be a string that has to be parsed
 * and defaulted at the point of use, and "is registration open" would be the
 * string "false" one careless write away from being truthy.
 *
 * Every column is nullable or defaulted, and lib/site-settings.ts falls back
 * to the values that were hardcoded before it existed — so an empty table
 * renders exactly the site that shipped, and nothing breaks if the row is
 * never created.
 */
model SiteSettings {
  /** Always SETTINGS_ID. The row is a singleton; see lib/site-settings.ts. */
  id String @id

  /** Shown on the public site and in the footer. */
  contactEmail String?

  facebookUrl  String?
  instagramUrl String?
  youtubeUrl   String?
  xUrl         String?

  /**
   * Whether the public registration form accepts submissions.
   *
   * Enforced in app/api/register/route.ts, not only hidden in the UI — a
   * closed form that still accepts a posted body is not closed.
   */
  registrationOpen Boolean @default(true)
  /** Shown in place of the form when registration is closed. */
  registrationClosedNote String?

  updatedAt DateTime @updatedAt
}

/**
 * A slot of work a volunteer signs up for.
 *
 * The volunteer tier promises "المساهمة في تنظيم المؤتمر" and "خبرة إدارية
 * وتنظيمية عملية", and until now the platform delivered neither — a
 * volunteer's dashboard was an attendee's with the innovations section taken
 * out. This is the thing that makes the tier real: who is on the door at nine,
 * who is in the hall at two, and how many are still needed.
 */
model VolunteerShift {
  id String @id @default(cuid())

  titleAr String
  /**
   * Which of the six organizing committees this shift belongs to — the keys in
   * lib/committees.ts.
   *
   * A volunteer belongs to one committee and claims within it, so this is not
   * a label but the thing that decides who may take the shift. It was free
   * text when the rota was first built and every organizer would have spelled
   * the same committee three ways.
   */
  committee String
  /** 'dayOne' | 'dayTwo' — the same keys the programme uses. */
  day     String
  /** Wall-clock at the venue, "09:00". Stored as text for the same reason
   *  ProgramSession does: it is printed, and a real time would invite a
   *  timezone conversion nobody asked for. */
  startTime String
  endTime   String
  location  String?
  notesAr   String?

  /** How many volunteers this slot needs. Claims are refused past it. */
  capacity Int @default(1)

  /** A closed shift accepts no new claims — the roster is settled. */
  isOpen Boolean @default(true)

  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments VolunteerAssignment[]

  @@index([day, order])
}

/** One volunteer on one shift. */
model VolunteerAssignment {
  id String @id @default(cuid())

  shiftId String
  shift   VolunteerShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  // Claiming the same shift twice is not a second pair of hands.
  @@unique([shiftId, userId])
  @@index([userId])
}

# The site's real production URL (used for canonical links, sitemap.xml, and
# Open Graph tags).
NEXT_PUBLIC_SITE_URL=https://cict2026.com

# Postgres connection string — from Vercel dashboard -> Storage -> Neon,
# connected to this project.
DATABASE_URL=

# Image uploads — from Vercel dashboard -> Storage -> Create Database -> Blob,
# connected to this project.
BLOB_READ_WRITE_TOKEN=

# Session signing secret for Auth.js. Generate one with `openssl rand -hex 32`.
AUTH_SECRET=

# First admin account — read once by `npx tsx scripts/seed-admin.ts`.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Transactional email — password-reset links. Without these the platform runs
# exactly as before: the reset form still accepts an address and still answers
# the same way, but no message goes out and a warning is logged. Set both to
# switch it on.
#
# A Resend API key (https://resend.com) — the provider is called directly over
# HTTPS, there is no SDK to install.
RESEND_API_KEY=
# The From address. Must be on a domain verified with the provider, or every
# send is rejected. e.g. "مؤتمر CICT <no-reply@cict2026.com>"
EMAIL_FROM=

# The site's real production URL (used for canonical links, sitemap.xml, and
# Open Graph tags). Defaults to https://cict2026.com if unset — override with
# the actual deployed domain.
NEXT_PUBLIC_SITE_URL=https://cict2026.com

# Sanity project — see sanity.io/manage after running `npx sanity@latest init`
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Server-only write token (Settings -> API -> Tokens -> Editor rights)
# Used by the registration API route and the one-off content migration script.
SANITY_API_TOKEN=

# Shared secret Sanity's publish webhook must send back for /api/revalidate
# to trust it. Any random string — generate one with `openssl rand -hex 16`.
SANITY_REVALIDATE_SECRET=
